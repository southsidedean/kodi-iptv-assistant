__pycache__/
.DS_Store
*.egg-info/
.venv/
.pytest_cache/
.coverage
.hypothesis/
# Created by kia. The empty folders are kept so Docker doesn't create them as root.
output/*
state/*
vendor/*
work/*
# The secure Dashboard's certificate.
tls/*
# Threadfin's settings, for Plex (compose.yaml, plex profiles). The empty folders are kept too.
threadfin/*/*
threadfin-2/*/*
!threadfin*/*/.gitkeep
# Plex's settings and database, and your media (compose.yaml, plex-server profile).
plex/*/*
!plex/*/.gitkeep
# Jellyfin's settings, database, and cache (compose.yaml, jellyfin-server profile).
jellyfin/*/*
!jellyfin/*/.gitkeep
media/*
!media/.gitkeep
# Prometheus's and Grafana's data, and your own targets and dashboards (monitoring profile).
monitoring/*/*
!monitoring/*/.gitkeep
# The gateway part's settings, its devices' key hashes, and its token for kia (scripts/gateway.sh).
gateway/*
# The front-door part's settings, its secrets, its accounts, and Authelia's database (scripts/frontdoor.sh).
frontdoor/*
!frontdoor/.gitkeep
# The kia-stack service's own files: its answers to the Dashboard, and the request it's on.
stack-service/
# Your profiles (the Dashboard writes them here), apart from the example.
profiles/*
!profiles/example.toml
!*/.gitkeep
.env
.env.bak*
.env.new
sources.local.txt
# Your own playlist files (see the end of sources.txt).
playlists/
*.tmp
