# Settings for running with Docker. Copy this file to .env and fill in "Basics".
# Leave anything else empty to use the default. Setup recipes: docs/setups.md
# Note: keep comments on their own lines; Docker reads "KEY=  # note" as the value.

# --- Basics -------------------------------------------------------------------------

# How Kodi and other devices reach this machine, e.g. http://192.168.1.20:8780 (see
# docs/install.md, "Find this computer's address"). Players find the guide through it.
KIA_PUBLIC_URL=

# Who can connect: 0.0.0.0 = any device on your network, 127.0.0.1 = this machine only.
KIA_BIND=0.0.0.0
KIA_PORT=8780

# Daily refresh time (24-hour clock) and your time zone, e.g. America/New_York.
KIA_RUN_AT=04:00
TZ=Etc/UTC
# Hours between quick guide refreshes during the day (default 4, 0 = off). Each takes
# seconds and keeps guides that list only the next few hours current.
KIA_GUIDE_REFRESH_HOURS=

# Your own playlist list instead of sources.txt, e.g. sources.local.txt (copy
# sources.txt to start). git ignores it, so updating kia never touches your choices.
KIA_SOURCES_FILE=

# Playlists for people and devices: your profiles file (default profiles/profiles.toml).
# See docs/profiles.md.
KIA_PROFILES_FILE=

# Pluto TV channels play through kia, so they keep going across ad breaks instead of
# freezing (true/false, default true). See docs/troubleshooting.md.
KIA_PLUTO_RELAY=

# --- The secure Dashboard (https://<address>:8743/), where you make changes -----

# Its port. Playlists and guides stay on KIA_PORT, because players refuse kia's
# self-signed certificate.
KIA_HTTPS_PORT=8743
# Names and addresses the certificate covers, comma-separated, e.g. kia.home.lan,192.168.1.20
# (default: the host in KIA_PUBLIC_URL). The first is the one the Dashboard links to.
KIA_TLS_NAMES=
# The password for making changes. Empty = kia makes one on first start and saves it in
# state/admin-password.txt; you can then change it on the Dashboard.
KIA_ADMIN_PASSWORD=
# Set to false to turn off changes from the Dashboard.
KIA_EDITING=

# Owner of the files kia writes. On Linux/macOS, `id -u` and `id -g` show yours.
PUID=1000
PGID=1000

# --- Laptops and other machines that move around ------------------------------------

# Also refresh when kia starts (true/false).
KIA_RUN_ON_START=
# A home kia server to copy the program guide from, e.g. http://my-server.lan:8780.
# Streams are still tested here; only the guide is copied.
KIA_UPSTREAM_URL=
# If the home server is unreachable: "grab" the guide here (default) or use the "cached" copy.
KIA_UPSTREAM_FALLBACK=

# --- Notifications ------------------------------------------------------------------

# Get alerts on your phone with ntfy (https://ntfy.sh): install the app, subscribe to a
# long, hard-to-guess topic name, and put its URL here. Empty = no notifications.
KIA_NTFY_URL=
# Or by email, through your email provider's server (docs/alerts.md has examples).
# KIA_SMTP_SECURITY is starttls (port 587, the default), ssl (port 465), or none.
KIA_SMTP_HOST=
KIA_SMTP_PORT=
KIA_SMTP_SECURITY=
KIA_SMTP_USER=
KIA_SMTP_PASSWORD=
# Who gets the alerts, comma-separated, and the From address (default: KIA_SMTP_USER).
KIA_EMAIL_TO=
KIA_EMAIL_FROM=
# Or run any command for each alert (gets $KIA_ALERT_EVENT, $KIA_ALERT_TITLE, $KIA_ALERT_MESSAGE).
KIA_ALERT_COMMAND=
# Which events notify you, comma-separated (default: all but daily_summary). Choices:
# dns_local, run_failed, channels_drop, guide_drop, site_failing, daily_summary,
# pluto_fallback (off unless you list it)
KIA_ALERT_EVENTS=

# --- Speed and memory (each guide site being downloaded peaks around 0.7 GB) --------

# Days of program guide (default 3).
KIA_EPG_DAYS=
# Guide sites downloaded at once (default 4).
KIA_PARALLEL_SITES=
# Streams tested at once (default 20).
KIA_CHECK_CONCURRENCY=
# Memory limit for kia (default 4g).
KIA_MEMORY_LIMIT=

# --- What's included ----------------------------------------------------------------

# Guide sites to skip, comma-separated, e.g. tvguide.com,xumo.tv
KIA_EXCLUDE_SITES=
# Channel categories to leave out, e.g. Religious,Shop
KIA_EXCLUDE_GROUPS=
# Show "<channel name>" blocks where there's no guide data (default true).
KIA_PLACEHOLDERS=
# The same for radio stations, so the radio guide shows their names (default false).
KIA_RADIO_PLACEHOLDERS=

# --- Advanced -----------------------------------------------------------------------

# Versions. Empty means the latest, updated as described in docs/configuration.md.
# To pin them, run scripts/pin-versions.sh, which writes today's versions here.
# iptv-org/epg: a fork's address, and a branch, tag, or commit (default: latest).
KIA_EPG_GIT_URL=
KIA_EPG_GIT_REF=

# Each container's log (docker compose logs) is kept in files of this size, this many at
# a time, so it can't fill the disk (default 10m and 3: at most 30 MB per container).
KIA_LOG_MAX_SIZE=
KIA_LOG_MAX_FILES=

# --- Plex (docs/plex.md) -------------------------------------------------------------

# Start Threadfin, which shows kia's channels to Plex as a TV tuner, with kia every time:
# plex for one tuner, plex,plex-2 for two (more than 480 channels). Empty = no Threadfin.
COMPOSE_PROFILES=
# Threadfin's web pages and Plex's tuner addresses (http://<your address>:34400).
KIA_THREADFIN_PORT=
KIA_THREADFIN_2_PORT=
# Threadfin's version (default: fyb3roptik/threadfin:1.2.37, the one these docs were tested with).
KIA_THREADFIN_IMAGE=
# The kia playlist each Threadfin reads (default: plex, or plex-1 when that's the one you
# made; Threadfin 2 reads plex-2). kia sets Threadfin up with these the first time it starts.
KIA_THREADFIN_PLAYLIST=
KIA_THREADFIN_2_PLAYLIST=
# For `kia plex-tuners`, which adds the Threadfins to Plex for you: Plex's address
# (e.g. http://192.168.1.20:32400) and a Plex token (docs/plex.md says how to find one).
KIA_PLEX_URL=
KIA_PLEX_TOKEN=
# Plex Media Server in the same stack (COMPOSE_PROFILES=plex,plex-server), for a home TV
# box (docs/cookbooks/plex-box.md). PLEX_CLAIM: a code from https://plex.tv/claim, for
# the first start only. KIA_PLEX_ADVERTISE: the address Plex apps use to reach it, such
# as http://192.168.1.20:32400/. With this, set KIA_PLEX_URL=http://plex:32400 and leave
# KIA_PLEX_TOKEN empty: kia uses Plex's own.
PLEX_CLAIM=
KIA_PLEX_ADVERTISE=
KIA_PLEX_PORT=
# The server's name in Plex apps (letters, digits, and dashes; default kia-tv-box).
KIA_PLEX_NAME=
KIA_PLEX_IMAGE=
# Where Plex keeps its settings and database (default plex/config in the kia folder),
# its temporary files while converting video (plex/transcode), and your movies and shows,
# which Plex can read but not change (default: media in the kia folder). On a Mac, the
# installer sets KIA_PLEX_CONFIG=plex-config, a Docker volume (docs/configuration.md#on-a-mac).
KIA_PLEX_CONFIG=
KIA_PLEX_TRANSCODE=
KIA_MEDIA_DIR=

# --- Monitoring: Prometheus and Grafana (docs/cookbooks/observability.md) --------------
# Add monitoring to COMPOSE_PROFILES (and monitoring-node, unless this computer already
# runs node-exporter on port 9100). Grafana's admin password, read on its first start; empty
# means Grafana makes one and saves it in monitoring/grafana/admin-password.txt.
KIA_GRAFANA_PASSWORD=
# Grafana's port (default 8788) and Prometheus's (8789, open to this computer only).
KIA_GRAFANA_PORT=
KIA_PROMETHEUS_PORT=
# Where node-exporter (monitoring-node) listens, default :9100 (every address). Docker's own
# address, such as 172.17.0.1:9100, keeps it off the rest of your network.
KIA_NODE_EXPORTER_LISTEN=
# How long Prometheus keeps the numbers (default 30d).
KIA_PROMETHEUS_RETENTION=
# Where they're kept (defaults: monitoring/prometheus and monitoring/grafana; on a Mac,
# the installer sets KIA_GRAFANA_DATA=grafana-data, a Docker volume).
KIA_PROMETHEUS_DATA=
KIA_GRAFANA_DATA=
# A Grafana elsewhere, for the Dashboard's Observability button (default: this computer's, with monitoring on).
KIA_GRAFANA_URL=
# Image versions (defaults: the latest of each).
KIA_PROMETHEUS_IMAGE=
KIA_GRAFANA_IMAGE=
KIA_CADVISOR_IMAGE=
KIA_NODE_EXPORTER_IMAGE=

# Docker images. kia's base (default cgr.dev/chainguard/wolfi-base:latest), the Node.js
# major version installed on it (default 24, the current LTS release), and nginx
# (default nginx:alpine). Rebuild after a change: docker compose up -d --build
KIA_BASE_IMAGE=
KIA_NODE_VERSION=
KIA_NGINX_IMAGE=
# Or skip building: use kia's published image (amd64 and arm64), e.g.
# ghcr.io/southsidedean/kodi-iptv-assistant:latest, or a release such as :0.4.0.
# Then update with: scripts/update.sh (it pulls the image instead of building it)
KIA_IMAGE=
