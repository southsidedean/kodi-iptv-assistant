# Copy to .env and adjust for your server. Used by `docker compose`.

# How Kodi devices reach this server (hostname or IP, plus KIA_PORT). This is written
# into the playlist so IPTV Simple can find the guide on its own.
KIA_PUBLIC_URL=http://my-server.lan:8780

# Port the playlist and guide are served on.
KIA_PORT=8780

# Daily run time (24h, local time) and your timezone (e.g. America/New_York, Europe/London).
KIA_RUN_AT=04:00
TZ=Etc/UTC

# Files in this folder are written as this user/group; use your own (`id -u`, `id -g`).
PUID=1000
PGID=1000

# --- Optional tuning (leave empty to use kia.toml) ---------------------------------
# Measured: grabbing one guide site peaks around 0.7 GB of RAM (~200 channels, 3 days),
# and KIA_PARALLEL_SITES sites are grabbed at once. For a 4 GB Raspberry Pi, try
# KIA_PARALLEL_SITES=1, KIA_CHECK_CONCURRENCY=8, KIA_MEMORY_LIMIT=2g.

# Days of guide data to fetch (more days = longer grabs and more memory).
KIA_EPG_DAYS=
# Guide sites grabbed at the same time (default 4).
KIA_PARALLEL_SITES=
# Streams tested at the same time (default 20).
KIA_CHECK_CONCURRENCY=
# Memory cap for the kia container (default 4g); a grab that exceeds it is killed and alerted.
KIA_MEMORY_LIMIT=

# --- Optional content settings (leave empty to use kia.toml) -----------------------
# Guide sites to skip, comma-separated (added to kia.toml's exclude_sites).
# Site names are as in output/mapping-report.md, e.g. tvguide.com,xumo.tv
KIA_EXCLUDE_SITES=
# Channel categories to drop before checking, comma-separated (added to kia.toml's
# exclude_groups). Uses iptv-org's group-title names, e.g. Religious,Shop
KIA_EXCLUDE_GROUPS=
# Fill channels that have no guide data with 2-hour "<channel name>" blocks: true/false.
KIA_PLACEHOLDERS=
