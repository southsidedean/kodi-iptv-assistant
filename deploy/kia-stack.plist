<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The kia-stack service for macOS, a launchd agent: scripts/stack.sh watch, which carries
     out the changes you make on the Dashboard's Stack page (docs/stack.md). It runs as you,
     because changing the stack needs Docker, which the kia container can't reach.
     scripts/install-service.sh --stack fills in the paths. Log: stack-service/kia-stack.log. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>io.github.southsidedean.kia-stack</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/sh</string>
    <string>@DIR@/scripts/stack.sh</string>
    <string>watch</string>
  </array>
  <key>WorkingDirectory</key>
  <string>@DIR@</string>
  <key>EnvironmentVariables</key>
  <dict>
    <!-- Where docker is: Docker Desktop puts it in /usr/local/bin. -->
    <key>PATH</key>
    <string>@PATH@</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>
  <key>ThrottleInterval</key>
  <integer>30</integer>
  <key>StandardOutPath</key>
  <string>@DIR@/stack-service/kia-stack.log</string>
  <key>StandardErrorPath</key>
  <string>@DIR@/stack-service/kia-stack.log</string>
</dict>
</plist>
