  {
   "id": 13,
   "type": "stat",
   "title": "Bad or pending sectors",
   "description": "Sectors disks have replaced, are waiting to replace, or couldn't read, in all. A number that grows means a disk is wearing out.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 6,
    "y": 14,
    "w": 6,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum(smartctl_device_attribute{attribute_name=~\"Reallocated_Sector_Ct|Current_Pending_Sector|Offline_Uncorrectable\",attribute_value_type=\"raw\"}) or count(smartctl_device) * 0",
     "legendFormat": ""
