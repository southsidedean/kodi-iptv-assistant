  {
   "id": 16,
   "type": "table",
   "title": "Each disk",
   "description": "SMART says OK (1) or failing (0); the counts should stay at 0. NVMe disks show their wear instead of the sector counts.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 18,
    "w": 24,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "max by (device) (smartctl_device_smart_status)",
     "legendFormat": "SMART OK",
     "format": "table",
     "instant": true
    },
    {
     "refId": "B",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "max by (device) (smartctl_device_temperature{temperature_type=\"current\"})",
     "legendFormat": "Temperature",
     "format": "table",
     "instant": true
    },
    {
     "refId": "C",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "max by (device) (smartctl_device_power_on_seconds) / 3600",
     "legendFormat": "Hours on",
     "format": "table",
     "instant": true
    },
    {
     "refId": "D",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "max by (device) (smartctl_device_attribute{attribute_name=\"Reallocated_Sector_Ct\",attribute_value_type=\"raw\"})",
     "legendFormat": "Replaced sectors",
     "format": "table",
     "instant": true
    },
    {
     "refId": "E",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "max by (device) (smartctl_device_attribute{attribute_name=\"Current_Pending_Sector\",attribute_value_type=\"raw\"})",
     "legendFormat": "Pending sectors",
     "format": "table",
     "instant": true
    },
    {
     "refId": "F",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "max by (device) (smartctl_device_attribute{attribute_name=\"Offline_Uncorrectable\",attribute_value_type=\"raw\"})",
     "legendFormat": "Unreadable sectors",
     "format": "table",
     "instant": true
    },
    {
     "refId": "G",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "max by (device) (smartctl_device_attribute{attribute_name=\"UDMA_CRC_Error_Count\",attribute_value_type=\"raw\"})",
     "legendFormat": "Cable errors",
     "format": "table",
     "instant": true
    },
    {
     "refId": "H",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
