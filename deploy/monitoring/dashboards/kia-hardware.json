   },
   "gridPos": {
    "x": 0,
    "y": 14,
    "w": 6,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "count(smartctl_device_smart_status == 0) or count(smartctl_device) * 0",
     "legendFormat": ""
    }
   ],
   "fieldConfig": {
    "defaults": {
