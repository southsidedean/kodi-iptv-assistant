  {
   "id": 12,
   "type": "timeseries",
   "title": "Threadfin streaming",
   "description": "What the Threadfins send to Plex: Live TV from kia's channels.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
