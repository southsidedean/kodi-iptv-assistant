{
 "uid": "kia-plex",
 "title": "Plex",
 "description": "Who's watching on Plex, from kia (KIA_PLEX_URL in .env).",
 "tags": [
  "kia"
 ],
 "timezone": "browser",
 "schemaVersion": 39,
 "version": 1,
 "editable": true,
 "graphTooltip": 1,
 "refresh": "1m",
 "time": {
  "from": "now-24h",
  "to": "now"
 },
 "links": [
  {
   "title": "kia's dashboards",
   "type": "dashboards",
   "tags": [
    "kia"
   ],
   "asDropdown": false
  }
 ],
 "templating": {
  "list": []
 },
 "panels": [
  {
   "type": "row",
   "title": "Now",
   "collapsed": false,
   "panels": [],
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 24,
    "h": 1
   },
   "id": 1
  },
  {
   "id": 2,
   "type": "stat",
   "title": "Plex",
   "description": "Whether Plex answered kia.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 1,
    "w": 4,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "kia_plex_up",
     "legendFormat": ""
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "mappings": [
      {
       "type": "value",
       "options": {
        "0": {
         "text": "Not answering",
         "color": "red"
        },
        "1": {
         "text": "OK",
         "color": "green"
        }
       }
      }
     ],
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "transparent",
        "value": null
       },
       {
        "color": "red",
        "value": -1000000000.0
       },
       {
        "color": "green",
        "value": 1
       }
      ]
     },
     "noValue": "kia isn't set up to ask Plex (KIA_PLEX_URL in .env)"
    },
    "overrides": []
   },
   "options": {
    "colorMode": "background",
    "graphMode": "none",
    "textMode": "value",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    }
   }
  },
  {
   "id": 3,
   "type": "stat",
   "title": "Watching Live TV",
   "description": "Plex players on Live TV now.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 4,
    "y": 1,
    "w": 5,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
