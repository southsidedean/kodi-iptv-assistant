{
 "uid": "kia",
 "title": "kia",
 "description": "kia's refreshes, channels, guide, sources, and Pluto TV relay (docs/metrics.md).",
 "tags": [
  "kia"
 ],
 "timezone": "browser",
 "schemaVersion": 39,
 "version": 1,
 "editable": true,
 "graphTooltip": 1,
 "refresh": "1m",
 "time": {
  "from": "now-24h",
  "to": "now"
 },
 "links": [
  {
   "title": "kia's dashboards",
   "type": "dashboards",
   "tags": [
    "kia"
   ],
   "asDropdown": false
  }
 ],
 "templating": {
  "list": []
 },
 "panels": [
  {
   "type": "row",
   "title": "Now",
   "collapsed": false,
   "panels": [],
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 24,
    "h": 1
   },
   "id": 1
  },
  {
   "id": 2,
   "type": "stat",
   "title": "Last refresh",
   "description": "The nightly refresh: OK, failed, or running now.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 1,
    "w": 4,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "kia_refresh_running * 2 + (1 - kia_refresh_running) * kia_last_refresh_success",
     "legendFormat": ""
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "mappings": [
      {
       "type": "value",
       "options": {
        "0": {
         "text": "Failed",
         "color": "red"
        },
        "1": {
         "text": "OK",
         "color": "green"
        },
        "2": {
         "text": "Refreshing",
         "color": "blue"
        }
       }
      }
     ],
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "green",
        "value": 1
       },
       {
        "color": "blue",
        "value": 2
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "colorMode": "background",
    "graphMode": "none",
    "textMode": "value",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    }
   }
  },
  {
   "id": 3,
   "type": "stat",
   "title": "Refresh took",
   "description": "How long the last nightly refresh took.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 4,
    "y": 1,
    "w": 4,
    "h": 4
